# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revaudit

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# error | warn | info | debug
LOG_LEVEL=info

# Secret used to sign JWTs — generate a long random value for real deployments,
# e.g. `openssl rand -hex 32`. Required in production.
JWT_SECRET=dev-only-insecure-secret-change-me

# How long an access token stays valid, e.g. "15m", "1h", "7d"
JWT_EXPIRES_IN=1h

# Which storage backend src/services/storage uses: "local" or "s3".
STORAGE_DRIVER=local

# Only used by the "local" driver. Defaults to backend/uploads if unset.
# UPLOAD_DIR=/absolute/path/to/uploads

# Per-file size limit and max files accepted in a single upload request
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_UPLOAD=20

# --- Only required when STORAGE_DRIVER=s3 ---
# Use an IAM user scoped to just this bucket (s3:PutObject, s3:GetObject) —
# never root/admin account keys. See backend/README.md for a sample policy.
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=

# Optional — only set this to point at an S3-compatible endpoint instead of
# real AWS (MinIO, another provider, local testing). Leave unset for AWS.
# AWS_S3_ENDPOINT=
