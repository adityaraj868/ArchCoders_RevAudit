# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revaudit

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# error | warn | info | debug
LOG_LEVEL=info

# Secret used to sign JWTs — generate a long random value for real deployments,
# e.g. `openssl rand -hex 32`. Required in production.
JWT_SECRET=dev-only-insecure-secret-change-me

# How long an access token stays valid, e.g. "15m", "1h", "7d"
JWT_EXPIRES_IN=1h
